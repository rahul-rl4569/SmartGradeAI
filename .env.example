NODE_ENV=development
PORT=4000
# Use 0.0.0.0 when the hosting platform requires an externally reachable interface
HOST=127.0.0.1
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_COOKIE_NAME=smartgrade_session
SESSION_TTL=8h
PASSWORD_RESET_TTL_MINUTES=20
CLIENT_URL=http://127.0.0.1:5173
DATABASE_PATH=./data/smartgrade.sqlite
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=10485760

# Review submission grading suggestions (OpenAI-compatible chat completions API)
# xKiro uses this OpenAI-compatible endpoint. Put your private key in server/.env
# (or the root .env used by your server setup); never commit it or expose it in the client.
GRADING_AI_BASE_URL=https://api.xkiro.com/v1
GRADING_AI_API_KEY=
GRADING_AI_MODEL=mistralai/mistral-medium-3.5
GRADING_AI_TIMEOUT_MS=90000

# Google Cloud Vision scanned-PDF text extraction (local development uses ADC).
# Run `gcloud auth application-default login` on the backend machine; no API key is used.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_VISION_TIMEOUT_MS=600000

# Phase 18: SMTP email notifications (leave blank to keep email delivery disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
